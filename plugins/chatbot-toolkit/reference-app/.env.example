ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=choose-a-random-verify-token

# Which channel this instance serves: whatsapp (default) or instagram.
CHANNEL=whatsapp

# WhatsApp (CHANNEL=whatsapp)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Instagram (CHANNEL=instagram)
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_ID=your-instagram-account-id
# Graph base URL. Default suits "Instagram API with Facebook Login".
# For "Instagram API with Instagram Login" use https://graph.instagram.com/v21.0
INSTAGRAM_GRAPH_URL=https://graph.facebook.com/v21.0

DATABASE_URL=postgresql://localhost/chatbot
